    "@types/node": "^26.3.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.2.10",
    "pngjs": "7.0.0",
    "prettier": "3.9.5",
    "typescript": "^5.9.0"
  }
